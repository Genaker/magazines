{
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.detectIndentation": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    "*.blade.php": "blade"
  },
  "[php]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "open-suggested"
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "open-suggested"
  },
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "search.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/public/build": true,
    "**/storage": true
  },
  "php.validate.enable": true,
  "intelephense.files.exclude": [
    "**/vendor/**",
    "**/node_modules/**"
  ]
}
