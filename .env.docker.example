APP_NAME=Magazines
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lvh.me:8888

# Share login across lvh.me and *.lvh.me (magazine/author subdomains).
# Do not use .localhost — browsers reject it (public suffix list).
SESSION_DOMAIN=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=magazines
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
POST_VIEW_COUNT_MODE=sync

CACHE_STORE=file
ENTITY_CACHE_ENABLED=true
ENTITY_CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SEARCH_DB=0

# Dedicated search Redis (optional): docker compose -f docker-compose.yml -f docker-compose.split-redis.yml up -d
# REDIS_SEARCH_HOST=redis-search
# REDIS_SEARCH_PORT=6379

SEARCH_DRIVER=redis
SEARCH_EMBEDDING_PROVIDER=none

# Optional semantic search:
# SEARCH_EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=your-key
# SEARCH_SEMANTIC_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@magazines.test"
MAIL_FROM_NAME="${APP_NAME}"

MAILPIT_WEB_URL=http://127.0.0.1:8025

FILESYSTEM_DISK=local
MEDIA_DISK=public
