APP_NAME=Magazines
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Site branding (installer, Docker seed, and UI fallbacks — see config/site.php)
SITE_NAME="${APP_NAME}"
SITE_TAGLINE="Local communities, publishers, and bloggers — with integrated AI writing assistants."
SITE_FOOTER_TAGLINE="Platform for a free society"
SITE_FOOTER_RIGHTS="All rights reserved."
SITE_COPYRIGHT_START=2014
SITE_THEME_COLOR=#111827
SITE_BACKGROUND_COLOR=#f3f4f6
SITE_HOME_LAYOUT=discover
# Admin URL prefix (default: admin). Restart PHP / clear route cache after changing.
ADMIN_PATH=admin
SITE_DEFAULT_LOCALE=en
SITE_ENABLED_LOCALES=en,ua
# SITE_TEMPLATE=magazine

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Attach URL, user id, etc. to exception log entries
LOG_EXCEPTION_CONTEXT=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magazines
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_PATH_PREFIX=media
MEDIA_JPEG_QUALITY=85
MEDIA_POST_RESIZE=true
MEDIA_POST_MAX_WIDTH=1500
MEDIA_POST_MAX_HEIGHT=1500
MEDIA_GALLERY_RESIZE=true
MEDIA_GALLERY_MAX_WIDTH=1500
MEDIA_GALLERY_MAX_HEIGHT=1500
MAX_TAGS_PER_POST=10
QUEUE_CONNECTION=sync

# Post view counting: sync (default, in-process after response) or async (queue worker)
POST_VIEW_COUNT_MODE=sync

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# RediSearch (Redis Stack). Unset REDIS_SEARCH_* to use the same host as REDIS_*.
# REDIS_SEARCH_HOST=127.0.0.1
# REDIS_SEARCH_PORT=6379
# REDIS_SEARCH_DB=0
# REDIS_SEARCH_PASSWORD=null

# Search: database (MySQL FULLTEXT / PostgreSQL tsvector or pg_search) | postgres | redis (RediSearch)
SEARCH_DRIVER=database

# Post fields: title, subtitle, body, tags, author_name, category_name
# SEARCH_FULLTEXT_FIELDS=title,subtitle,body,tags,author_name,category_name
# SEARCH_EMBEDDING_FIELDS=title,subtitle,body,tags
# Body truncation (0 = full post). Default 100 words for both unless overridden:
# SEARCH_POST_BODY_MAX_WORDS=100
# SEARCH_FULLTEXT_BODY_MAX_WORDS=100
# SEARCH_EMBEDDING_BODY_MAX_WORDS=100

# Field weights (RediSearch only)
# SEARCH_WEIGHT_TITLE=5
# SEARCH_WEIGHT_SUBTITLE=3
# SEARCH_WEIGHT_BODY=1
# SEARCH_WEIGHT_AUTHOR=2
# SEARCH_WEIGHT_CATEGORY=1.5

# Text preprocessing (stop words, token savings)
# SEARCH_STRIP_HTML=true
# SEARCH_LOWERCASE_EMBEDDING=true
# SEARCH_MIN_TOKEN_LENGTH=2
# SEARCH_REMOVE_STOP_WORDS_EMBEDDING=true
# SEARCH_REMOVE_STOP_WORDS_FULLTEXT=false
# SEARCH_REMOVE_STOP_WORDS_QUERY=true

# Embeddings: none | gemini | openai
SEARCH_EMBEDDING_PROVIDER=none
# SEARCH_SEMANTIC_ENABLED=true
# SEARCH_EMBEDDING_DIMENSIONS=768
# SEARCH_EMBEDDING_QUERY_CACHE_TTL=900
# SEARCH_HYBRID_TEXT_WEIGHT=0.4
# SEARCH_HYBRID_VECTOR_WEIGHT=0.6

# PostgreSQL pg_search BM25 (ParadeDB — docker-compose postgres service)
# SEARCH_DRIVER=postgres
# SEARCH_PG_SEARCH_ENABLED=true
# SEARCH_PG_SEARCH_MATCH=any
# SEARCH_PGVECTOR_ENABLED=true

# Gemini
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI-compatible APIs
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# OPENAI_API_BASE=https://api.openai.com/v1

# Entity query cache (Redis-backed Eloquent reads; disable for debugging)
ENTITY_CACHE_ENABLED=true
# Optional: dedicated store for entity caching (defaults to CACHE_STORE)
ENTITY_CACHE_STORE=redis
ENTITY_CACHE_TTL_CATEGORIES=3600
ENTITY_CACHE_TTL_FEEDS=300
ENTITY_CACHE_TTL_POSTS=600
ENTITY_CACHE_TTL_AUTHORS=600
ENTITY_CACHE_TTL_TAGS=3600

# Mailpit (Docker): http://127.0.0.1:8025 — one instance via docker-compose only
MAILPIT_WEB_URL=http://127.0.0.1:8025
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@magazines.test"
MAIL_FROM_NAME="${APP_NAME}"

SUBSCRIPTION_EMAIL_ENABLED=true
SUBSCRIPTION_DEFAULT_DELIVERY=instant
SUBSCRIPTION_DIGEST_TIME=08:00

# Notification emails: sync (default) or queue (processed by scheduler every minute)
NOTIFICATION_EMAIL_DELIVERY=sync
NOTIFICATION_EMAIL_QUEUE=mail

# Master switch for config/schedule.php tasks (single cron via schedule:run)
SCHEDULER_ENABLED=true

MIN_GALLERY_PHOTOS=2
MAX_GALLERY_PHOTOS=100

VITE_APP_NAME="${APP_NAME}"

# Docker: docker-compose up -d --build → app :8888, Mailpit :8025
